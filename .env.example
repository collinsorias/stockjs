# --- Database -------------------------------------------------------------
# DATABASE_URL is the pooled connection the app uses at runtime. On serverless
# hosts, point this at your provider's pooler so many invocations share a
# small number of real Postgres connections.
#
#   Neon:            postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#   Supabase:        postgresql://postgres.PROJECT:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres
#   Vercel Postgres: postgresql://...@...-pooler.REGION.postgres.vercel-storage.com/DB?sslmode=require
#
# Local development:
#   postgresql://USER:PASSWORD@localhost:5432/stockjs?schema=public
DATABASE_URL="postgresql://postgres:root@localhost:5432/stockjs?schema=public"

# DIRECT_URL is the non-pooled connection, used ONLY by `prisma migrate`.
# Migrations need a long-lived session and cannot run through a
# transaction-mode pooler. Not used by the app at runtime.
# Local development has no pooler, so this is the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:root@localhost:5432/stockjs?schema=public"

# --- Auth -----------------------------------------------------------------
# Must be a unique, long random value. The app REFUSES TO START in production if
# this is missing or left at the development default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Public origin of the deployed app, used for redirects after logout.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: seeding the first admin ------------------------------------
# The bootstrap helper is opt-in and requires an explicit password, so no
# guessable default admin can be deployed by accident. Leave blank to skip.
DEFAULT_ADMIN_EMAIL="admin@stockjs.local"
DEFAULT_ADMIN_PASSWORD=""

# --- Optional: market data ------------------------------------------------
# Without these, quotes/history fall back to unauthenticated or empty results.
FINNHUB_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# --- Optional: Redis cache (Upstash) --------------------------------------
# Caching silently no-ops when unset; every request hits the database/API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Superaccess (internal admin area) ------------------------------------
# In production these default to EMPTY, so logins fail safely unless set here.
SUPERACCESS_USERNAME="admin"
SUPERACCESS_PASSWORD=""
