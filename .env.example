# --- Database -------------------------------------------------------------
# DATABASE_URL is the PostgreSQL connection the app uses at runtime.
# For Supabase, use the session pooler (port 5432) because Prisma needs
# long-lived sessions. Supabase's transaction pooler (port 6543) is intended
# for high-concurrency application traffic and is not used as DIRECT_URL.
#
#   Supabase session pooler:
#     postgresql://USER.PROJECT:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#   Supabase direct endpoint:
#     postgresql://postgres:PASS@db.PROJECT.supabase.co:5432/postgres?sslmode=require
#
# If the direct endpoint is unreachable (for example, IPv6-only networking),
# use the reachable session pooler for DIRECT_URL as a safe migration fallback.
# Local development:
#   postgresql://USER:PASSWORD@localhost:5432/stockjs?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stockjs?schema=public"

# DIRECT_URL is used ONLY by `prisma migrate`.
# Migrations need a long-lived session and must not use the transaction pooler.
# Local development has no pooler, so this is the same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/stockjs?schema=public"

# --- Auth -----------------------------------------------------------------
# Must be a unique, long random value. The app REFUSES TO START in production if
# this is missing or left at the development default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-run-the-crypto-command-above"

# Public origin of the deployed app, used for redirects after logout.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: seeding the first admin ------------------------------------
# The bootstrap helper is opt-in and requires an explicit password, so no
# guessable default admin can be deployed by accident. Leave both values blank
# to skip, or set DEFAULT_ADMIN_EMAIL and DEFAULT_ADMIN_PASSWORD TOGETHER.
DEFAULT_ADMIN_EMAIL=""
DEFAULT_ADMIN_PASSWORD=""

# --- Optional: market data ------------------------------------------------
# Without these, quotes/history fall back to unauthenticated or empty results.
FINNHUB_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# --- Optional: Redis cache (Upstash) --------------------------------------
# Caching silently no-ops when unset; every request hits the database/API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Superaccess (internal admin area) ------------------------------------
# In production these default to EMPTY, so logins fail safely unless set here.
# Both SUPERACCESS_USERNAME and SUPERACCESS_PASSWORD must be set explicitly to
# enable the admin area.
SUPERACCESS_USERNAME=""
SUPERACCESS_PASSWORD=""
